# Python 虚拟环境（每台机器自己建，不进版本控制）
service/.venv/
__pycache__/
*.py[cod]
*.egg-info/

# 依赖校验标记
service/.venv/.deps-ok

# 点选识别模型（182MB，插件首次运行自己下）
service/.models/
*.part

# pip 引导脚本（venv 缺 pip 时临时下载，用完即删；进程被中断可能残留）
service/.get-pip.py

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 日志与临时文件
*.log
_s*.out
_s*.err
